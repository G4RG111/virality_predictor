# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibepass
POSTGRES_DB=vibe_db
DATABASE_URL=postgresql://vibe:vibepass@localhost:5432/vibe_db

# ── Backend ───────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production
ENVIRONMENT=development
UPLOAD_DIR=./uploads
ML_PIPELINE_PATH=./ml

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── ML Pipeline ───────────────────────────────────────────────────────
# Sentence transformer model (downloaded on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# HuggingFace cache dir (optional — avoids re-downloading)
HF_HOME=./ml/data/models/hf_cache

# ── Feature Flags ─────────────────────────────────────────────────────
# Set to true to use XGBoost model instead of weighted formula (Phase 3+)
USE_ML_MODEL=false
# Minimum reviews before score is considered MEDIUM confidence
MIN_REVIEWS_MEDIUM=50
MIN_REVIEWS_HIGH=200
